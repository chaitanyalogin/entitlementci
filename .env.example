NODE_ENV=development
LOG_LEVEL=info
APP_NAME=EntitlementCI
API_PORT=4000
WEB_PORT=5173
TASKFLOW_PORT=4100
WORKER_HEALTH_PORT=4200
PUBLIC_WEB_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:4000
TASKFLOW_URL=http://localhost:4100
DATABASE_URL=postgresql://entitlementci:entitlementci@localhost:5432/entitlementci?schema=public
REDIS_URL=redis://localhost:6379
SESSION_COOKIE_NAME=entitlementci_session
SESSION_TTL_SECONDS=604800
SESSION_SECRET=replace-with-at-least-32-random-bytes
API_KEY_PEPPER=replace-with-at-least-32-random-bytes
WEBHOOK_SIGNING_SECRET=replace-with-at-least-32-random-bytes
CORS_ORIGIN=http://localhost:5173
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
EMAIL_TRANSPORT=console
EMAIL_FROM=no-reply@example.test
OBSERVATION_RETENTION_DAYS=30
WEBHOOK_RETENTION_DAYS=30
AUDIT_RETENTION_DAYS=365

# TaskFlow demo
TASKFLOW_DATABASE_URL=postgresql://entitlementci:entitlementci@localhost:5432/entitlementci?schema=public
TASKFLOW_API_KEY=
TASKFLOW_BUG_SCENARIO=none
